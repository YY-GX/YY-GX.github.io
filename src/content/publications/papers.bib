@inproceedings{yue2022cbfirl,
  title={Safe Inverse Reinforcement Learning via Control Barrier Function},
  author={Yang, Yue and Chen, Letian and Gombolay, Matthew},
  booktitle={Proceedings of CoRL Learning for Agile Robotics workshop},
  bibtex_show={true},
  year={2022},
  pdf={https://arxiv.org/pdf/2212.02753},
  preview={corl22.png},
  code={https://github.com/YY-GX/CBFIRL},
  blurb={Inverse reinforcement learning copies the reward behind a demonstration, but nothing in it keeps a fast car or drone from hitting a wall. Rather than filtering actions afterwards, we fold a control barrier function straight into the training loss, so safety and reward-matching are learned together. Tested on a 2D racecar and a 3D drone.},
