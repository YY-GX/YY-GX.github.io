}

@article{conlon2025competency,
  title={Competency-Aware Collaborative Robotic Surface Exploration: A Study at the Mars Desert Research Station},
  author={Conlon, Nicholas and Sawicki, Pawel and Yang, Yue and Ahmed, Nisar R and Szafir, Daniel},
  journal={IEEE Transactions on Field Robotics (T-FR)},
  year={2025},
  publisher={IEEE},
  pdf={https://ieeexplore.ieee.org/stamp/stamp.jsp?tp=&arnumber=11154044},
  preview={tfr25.png},
  blurb={Astronauts will one day hand jobs to autonomous rovers, but only if they can judge when a rover is likely to fail. We spent two weeks with a Mars Desert Research Station crew in Utah, running a ground robot that estimates its own competence and reports it, then watched how the crew planned around it.},
  topics={hri}
}

@article{fang2025rebot,
  title={Rebot: Scaling robot learning with real-to-sim-to-real robotic video synthesis},
  author={Fang, Yu and Yang, Yue and Zhu, Xinghao and Zheng, Kaiyuan and Bertasius, Gedas and Szafir, Daniel and Ding, Mingyu},
  journal={Proceedings of the 2025 IEEE/RSJ International Conference on Intelligent Robots and Systems (IROS)},
  year={2025},
  pdf={https://arxiv.org/pdf/2503.14526},
  preview={iros25.png},
  website={https://yuffish.github.io/rebot/},
  code={https://github.com/yuffish/rebot},
  blurb={Robot data is expensive, so a pretrained policy often meets your lab table and objects only on deployment day. Instead of collecting more, we replay real trajectories in a simulator with swapped objects, then paste those motions back onto inpainted real video. The output is new training clips with real backgrounds and physically believable motion.},
  topics={data}
}


@article{yang2025boss,
  title={BOSS: Benchmark for Observation Space Shift in Long-Horizon Task},
  author={Yang, Yue and Zhao, Linfeng and Ding, Mingyu and Bertasius, Gedas and Szafir, Daniel},
  journal={IEEE Robotics and Automation Letters (RA-L), presented at ICRA 2026},
  year={2025},
  preview={ral25.png},
  pdf={https://arxiv.org/pdf/2502.15679},
  selected = {true},
  website={https://boss-benchmark.github.io/},
  code={https://github.com/Boss-Benchmark/BOSS},
  blurb={Run one skill and it quietly rewrites the scene for the next one: the drawer is now open, the mug is now in the gripper, and the second policy has never seen that. We call this observation space shift, build a benchmark that isolates it three ways, and ask whether more varied demos are enough.},
  topics={skills}
}

@inproceedings{ma2025supporting,
  title={Supporting Long-Horizon Tasks in Human-Robot Collaboration by Aligning Intentions via Augmented Reality},
  author={Ma, Chenyang and Yang, Yue and Ikeda, Bryce and Szafir, Daniel},
