@article{jiang2026halter,
  title={From Rollout to Reset: A Graph-Based Harness for Autonomous Long-Horizon Manipulation Evaluation},
  author={Jiang, Jing and Yang, Yue and Jiang, Xinkai and Bertasius, Gedas and Szafir, Daniel and Lioutikov, Rudolf},
  journal={In submission to IEEE International Conference on Robotics and Automation (ICRA) 2027},
  year={2026},
  equal={Jing Jiang, Yue Yang},
  website={https://yy-gx.github.io/HALTER/},
  code={https://github.com/YY-GX/HALTER},
  preview={icra27_halter.jpg},
  blurb={Testing a real robot means a human resetting every object between rollouts, which eats hours and leaves the starting state undefined, so results rarely reproduce. Long tasks make it worse. We build a scene graph, let an LLM read it to score the run and plan the cleanup, then chain small skills to reset.},
  topics={skills}
}

@article{yang2026sensing,
  title={Evidence-Gated Cross-Modal Invariance for Robust Vision-Language-Action Policies},
  author={Yang, Yue and Romeres, Diego and Hori, Chiori and Bertasius, Gedas and Szafir, Daniel and Jain, Siddarth},
  journal={In submission to IEEE International Conference on Robotics and Automation (ICRA) 2027},
  year={2026},
  pdf={https://arxiv.org/pdf/2609.03142},
  website={https://yy-gx.github.io/EGR/},
  preview={icra27_egr.png},
  blurb={Block a camera that shows nothing useful and a multi-sensor robot policy still falls apart, because training on narrow demos ties the sensors together instead of to the task. Our fix scores, frame by frame, which sensor carries evidence, then trains the policy to ignore the useless ones and work from the useful one alone.},
  topics={skills}
}

@article{fang2026densereward,
  title={DenseReward: Dense Reward Learning via Failure Synthesis for Robotic Manipulation},
  author={Fang, Yu and Dong, Wanxi and Liu, Jiaqi and Yang, Yue and Huo, Mingxiao and Mu, Yao and Yao, Huaxiu and Li, Li Erran and Szafir, Daniel and Ding, Mingyu},
  journal={In submission to IEEE International Conference on Robotics and Automation (ICRA) 2027},
  year={2026},
  pdf={https://arxiv.org/pdf/2607.13033},
  website={https://dense-reward.github.io/},
  preview={icra27_densereward.jpg},
  blurb={Reward models for robots mostly say pass or fail at the end of a run, which tells a learner nothing about where things went wrong. Fake failures made by relabeling good runs look nothing like a dropped cup, so we build realistic ones in simulation and train a model that scores progress frame by frame.},
  topics={data}
}

@article{ma2026furniturevla,
  title={FurnitureVLA: Learning Long-Horizon Bimanual Furniture Assembly with Vision-Language-Action Model},
  author={Ma, Chenyang and Yang, Yue and Corcodel, Radu and Jain, Siddarth and Wu, Andrew and Hori, Chiori and Romeres, Diego},
  journal={In submission to IEEE Robotics and Automation Letters (RA-L)},
  year={2026},
  pdf={https://arxiv.org/pdf/2607.01212},
  website={https://dannymcy.github.io/furniturevla/},
  preview={ral_furniturevla.jpg},
  blurb={Assembling real furniture takes two arms and over 1500 control steps, but most robot assembly work stops at toy parts and a single arm. We build a simulation data pipeline and a VR rig that lets one person drive both arms. The policy predicts how far along it is, so it moves on by itself.},
  topics={skills}
}

@article{li2026watchact,
  title={WatchAct: A Benchmark for Behavior-Grounded Robot Manipulation},
  author={Li, Baiqi and Zhang, Ce and Fang, Yu and Yang, Yue and Li, Shangzhe and Ding, Mingyu and Bertasius, Gedas},
  journal={In submission to IEEE International Conference on Robotics and Automation (ICRA) 2027},
  year={2026},
  pdf={https://arxiv.org/pdf/2606.26443},
  website={https://baiqi-li.github.io/watchact_page/},
  code={https://github.com/Baiqi-Li/WatchAct},
  preview={icra27_watchact.png},
  blurb={A robot helping a person needs to know what they already did and why, yet manipulation benchmarks hand a policy one instruction and one snapshot. WatchAct builds 3,000 cases pairing real human video with a matching simulator scene and a runnable task, then scores planning and execution separately so you see which half broke.},
  topics={skills}
}

@article{yang2026lilo,
  title={LiLo-VLA: Compositional Long-Horizon Manipulation via Linked Object-Centric Policies},
  author={Yang, Yue and Cheng, Shuo and Fang, Yu and Bharadhwaj, Homanga and Ding, Mingyu and Bertasius, Gedas and Szafir, Daniel},
  journal={In submission to IEEE Transactions on Robot Learning (T-RL)},
  year={2026},
  pdf={https://arxiv.org/pdf/2602.21531},
  preview={icra27_lilovla.webp},
  website={https://yy-gx.github.io/LiLo-VLA/},
  code={https://github.com/YY-GX/LiLo-VLA},
  blurb={A skill trained on a tidy table gets distracted by a mug it never needed, and one slip in a chain ruins everything after. We split the job: one module drives the arm to the right place, a second looks only at the object being touched. The split lets the robot replan and reuse skills.},
  topics={skills}
}

@article{fang2026vision,
  title={When Vision Overrides Language: Evaluating and Mitigating Counterfactual Failures in VLAs},
  author={Fang, Yu and Feng, Yuchun and Jing, Dong and Liu, Jiaqi and Yang, Yue and Wei, Zhenyu and Szafir, Daniel and Ding, Mingyu},
  journal={Proceedings of the Conference on Robot Learning (CoRL)},
  year={2026},
  pdf={https://arxiv.org/pdf/2602.17659},
  preview={corl26_yu.jpg},
  website={https://vla-cf.github.io/},
  code={https://github.com/yuffish/LIBERO-CF},
  blurb={Tell a VLA to pick up the bowl where it usually trained on the plate, and it often grabs the plate anyway: the visual habit beats the words. We build a test set that swaps instructions on familiar layouts, then run each policy beside a language-blind twin and use the gap to steer it back.},
