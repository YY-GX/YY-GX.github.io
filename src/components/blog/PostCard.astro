---
import { formatDate } from '@lib/utils';

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  slug: string;
  readingTime: number;
}

const { title, description, date, tags, slug, readingTime } = Astro.props;
---

<a href={`/blog/${slug}`} class="surface-card block group animate-on-scroll">
  <h2 class="text-[length:var(--text-md)] font-[var(--weight-bold)] leading-[var(--leading-snug)] text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors">{title}</h2>
  <p class="mt-[var(--rhythm-tight)] text-[length:var(--text-sm)] leading-[var(--leading-normal)] text-[var(--color-text-secondary)] line-clamp-2">{description}</p>
  <div class="mt-[var(--space-3)] flex flex-wrap items-center gap-[var(--space-3)] text-[length:var(--text-xs)] text-[var(--color-text-secondary)]">
    <time class="nums">{formatDate(date)}</time>
    <span>&middot;</span>
    <span class="nums">{readingTime} min read</span>
    {tags.length > 0 && (
      <>
        <span>&middot;</span>
        <div class="flex flex-wrap gap-[var(--space-2)]">
          {tags.slice(0, 3).map(tag => (
            <span class="pill" style="background: var(--color-accent-soft); color: var(--color-accent);">{tag}</span>
          ))}
        </div>
      </>
    )}
  </div>
</a>
