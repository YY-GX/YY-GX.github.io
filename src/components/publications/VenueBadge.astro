---
interface Props {
  type: string;
}

const { type } = Astro.props;

// Colours come from the §2.6 venue tokens in global.css (light + dark, all AA).
const KNOWN = ['conference', 'journal', 'workshop', 'preprint', 'thesis'];
const t = KNOWN.includes(type) ? type : 'other';
---

<span class="pill" style={`background: var(--venue-${t}-bg); color: var(--venue-${t}-fg);`}>
  <span class="pill-dot" style={`background: var(--venue-${t}-fg);`}></span>
  {type}
</span>
