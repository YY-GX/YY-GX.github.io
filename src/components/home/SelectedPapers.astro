---
import { parseBibTeX } from '@lib/bibtex';
import { getConfig } from '@lib/config';
import PublicationCard from '@components/publications/PublicationCard.astro';
import fs from 'node:fs';
import path from 'node:path';

const config = getConfig();

let selectedPubs: any[] = [];
try {
  const bibPath = path.resolve(process.cwd(), 'src/content/publications', config.publications.bibtex_file);
  const bibContent = fs.readFileSync(bibPath, 'utf-8');
  const allPubs = parseBibTeX(bibContent);
  selectedPubs = allPubs.filter(p => p.selected).slice(0, 5);
  if (selectedPubs.length === 0) selectedPubs = allPubs.slice(0, 5);
} catch {}
---

<section class="animate-on-scroll">
  <div class="flex items-center gap-[var(--space-4)] mb-[var(--rhythm-heading)]">
    <h2 class="rule-heading flex-1 min-w-0 text-[length:var(--text-xl)] font-[var(--weight-bold)] text-[var(--color-text)]">
      <span>Selected Publications</span>
    </h2>
    {config.pages.publications && (
      <a href="/publications" class="shrink-0 text-[length:var(--text-sm)] text-[var(--color-accent)] hover:underline">View all &rarr;</a>
    )}
  </div>

  <div class="space-y-[var(--rhythm-item)]">
    {selectedPubs.map(pub => (
      <PublicationCard pub={pub} authorName={config.publications.author_name} variant="compact" />
    ))}
  </div>
</section>
