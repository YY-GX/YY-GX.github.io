---
interface TimelineItem {
  title: string;
  subtitle: string;
  date: string;
  description?: string;
}

interface Props {
  items: TimelineItem[];
}

const { items } = Astro.props;
---

<div class="relative">
  <!-- Timeline line -->
  <div class="absolute left-[7px] top-[0.7em] bottom-[0.7em] w-px bg-[var(--color-hairline)]"></div>

  <div class="space-y-[var(--rhythm-block)]">
    {items.map((item) => (
      <div class="relative pl-[var(--space-6)]">
        <!-- Dot -->
        <div class="absolute left-0 top-[0.45em] w-[15px] h-[15px] rounded-full border-2 border-[var(--color-accent)] bg-[var(--color-bg)]"></div>

        <div>
          <h3 class="text-[length:var(--text-md)] font-[var(--weight-bold)] text-[var(--color-text)]">{item.title}</h3>
          <p class="text-[length:var(--text-sm)] text-[var(--color-accent)]">{item.subtitle}</p>
          <p class="eyebrow nums mt-[var(--space-1)]">{item.date}</p>
          {item.description && (
            <p class="mt-[var(--space-2)] text-[length:var(--text-sm)] leading-[var(--leading-normal)] max-w-[var(--measure-prose)] text-[var(--color-text-secondary)]">{item.description}</p>
          )}
        </div>
      </div>
    ))}
  </div>
</div>
